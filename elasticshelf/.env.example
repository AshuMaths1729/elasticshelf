# Copy to .env and fill in to enable live Muse context-model calls. Without
# credentials the context engine runs in mock mode (deterministic, offline-safe).
MUSE_MODEL=muse-spark-1.3
MUSE_BASE_URL=https://api.meta.ai/v1   # Meta Model API (Chat Completions)
MODEL_API_KEY=                          # from the Model API dashboard → API keys
# Store simulation defaults
STORE_ID=ST-4092
SIM_TICK_SECONDS=2.0
# Store location for the Open-Meteo forecast (scripts/fetch_open_data.py)
STORE_LAT=37.77
STORE_LON=-122.41
# Pricing policy: auto (DQN first) | dqn | ppo | rule | tuned-rule | mpc
ELASTICITY_POLICY=tuned-rule
ELASTICITY_WASTE_WEIGHT=2.0
# Live serve-time pricing profile: waste-first (cross-SKU waste gate,
# ~30% units wasted, thin margin) | balanced (late ladder, ~32.5%, more
# profit). Individual overrides: ELASTICITY_WASTE_LADDER (early|standard|
# late|off), ELASTICITY_MARKDOWN_SPACING, ELASTICITY_SELLING_HOURS (0/1),
# ELASTICITY_WASTE_GATE (0/1), ELASTICITY_GATE_PUSH, ELASTICITY_GATE_DEEP.
ELASTICITY_LIVE_PROFILE=auto
# Live-trained PPO (joint profit + waste reward, 7-dim cross-SKU state):
# 1 = serve data/ppo_live_weights.pt in learned mode (ties waste-first).
ELASTICITY_PPO_LIVE=0
# Ordering: sell-through (default) | legacy (velocity x lifespan + waste);
# target = fraction of projected demand to order; auto-restock delivers
# each depleted SKU's suggested order at opening time.
ELASTICITY_ORDER_POLICY=sell-through
ELASTICITY_ORDER_TARGET=0.35
ELASTICITY_AUTO_RESTOCK=0
