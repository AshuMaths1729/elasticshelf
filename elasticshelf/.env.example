# Copy to .env and fill in to enable live context-model calls. Without
# credentials the context engine runs in mock mode (deterministic, offline-safe).
LLAMA_PROVIDER=spark          # spark | groq | together | none
LLAMA_MODEL=muse-spark-1.3-contributor
LLAMA_BASE_URL=               # OpenAI-compatible base URL, e.g. https://.../v1
SPARK_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
# Store simulation defaults
STORE_ID=ST-4092
SIM_TICK_SECONDS=2.0
# Pricing policy: auto (DQN first) | dqn | ppo | rule | tuned-rule | mpc
ELASTICITY_POLICY=tuned-rule
ELASTICITY_WASTE_WEIGHT=2.0
